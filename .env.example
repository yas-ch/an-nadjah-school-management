# ─── AN-NADJAH — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required: DATABASE_URL, JWT_SECRET
# Optional: PORT (default 3001), HOSTNAME (default 0.0.0.0)

# ── Database ─────────────────────────────────────────────────────────────────
# Required: Neon PostgreSQL connection string
# Get this from: Neon Dashboard → Connection Details → "Prisma" tab
# IMPORTANT: sslmode=require is REQUIRED for Neon
DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ── Authentication ───────────────────────────────────────────────────────────
# Required: Secret key for JWT token signing (min 32 chars)
# Generate with: openssl rand -hex 32
JWT_SECRET="change-this-to-a-random-secret-at-least-32-chars-long"

# ── Server ───────────────────────────────────────────────────────────────────
# Optional: Port for Next.js to listen on (default: 3001)
# Must match the port in nginx proxy_pass and ecosystem.config.js
PORT=3001

# Optional: Hostname to bind to (default: 0.0.0.0)
HOSTNAME=0.0.0.0

# ── Environment ──────────────────────────────────────────────────────────────
# Set automatically by PM2/Next.js. Do NOT override manually.
# NODE_ENV=production
