# ─── AN-NADJAH — Environment Variables ──────────────────────────────────────

# Required: Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# Required: Secret key for JWT token signing (use a strong random string)
JWT_SECRET="change-this-to-a-random-secret-at-least-32-chars-long"
