# ─── AN-NADJAH — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values
#   cp .env.example .env

# ── Database ─────────────────────────────────────────────────────────────────
# Required: Neon PostgreSQL connection string
# Get this from: Neon Dashboard → Connection Details → "Prisma" tab
# Make sure sslmode=require is included for Neon
DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ── Authentication ───────────────────────────────────────────────────────────
# Required: Secret key for JWT token signing (min 32 chars, use a random string)
# Generate with: openssl rand -hex 32
JWT_SECRET="change-this-to-a-random-secret-at-least-32-chars-long"

# ── Environment ──────────────────────────────────────────────────────────────
# Set automatically by PM2/Next.js. Only override if needed.
# NODE_ENV=production
